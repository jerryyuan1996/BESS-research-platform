{
  "name": "bess-research-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Global BESS investment research platform — public static site. Home cockpit + per-market dashboards.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "test:structural": "node --test tests/registry.test.js tests/governance.test.js tests/finance.test.js",
    "test:bundle": "node --test tests/bundle-confidentiality.test.js",
    "test:budget": "node --test tests/bundle-budget.test.js",
    "test:current": "node --test tests/baseline.test.js tests/current-model.test.js",
    "//test:baseline": "REGENERATES the frozen fixture — it is not a check. Run test:current to VERIFY that no published number moved; run this only when a number is meant to move, and expect to justify the diff.",
    "test:baseline": "node tests/fixtures/generate.mjs > tests/fixtures/legacy-baseline.json",
    "guard:staged": "node scripts/scan-staged.mjs",
    "guard:fingerprint": "node scripts/confidential-fingerprint.mjs",
    "guard:install": "git config core.hooksPath .githooks",
    "etl:verify:gb": "node etl/verify-gb-official.mjs",
    "etl:verify:grid-maps": "node etl/verify-grid-map-sources.mjs",
    "etl:verify:public-sources": "node etl/verify-public-sources.mjs",
    "refresh:grid-boundaries": "node scripts/refresh-grid-boundaries.mjs",
    "etl": "node etl/run.mjs",
    "etl:news": "node etl/run.mjs --only industry-news",
    "etl:dry": "node etl/run.mjs --dry-run",
    "etl:verify": "node etl/verify.mjs",
    "etl:propose": "node etl/propose.mjs",
    "refresh:market-boundaries": "node scripts/generate-market-boundaries.mjs",
    "refresh:market-zones": "node scripts/generate-market-zones.mjs",
    "refresh:grid-networks": "node scripts/refresh-grid-networks.mjs",
    "refresh:storage": "node scripts/refresh-storage.mjs",
    "audit:links": "node scripts/link-audit.mjs",
    "view:check-held": "node scripts/view/check-held.mjs",
    "view:track-record": "node scripts/view/track-record.mjs",
    "view:scout-status": "node scripts/view/scout-status.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "exceljs": "^4.4.0",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "d3-geo": "^3.1.1",
    "flag-icons": "^7.5.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  }
}
