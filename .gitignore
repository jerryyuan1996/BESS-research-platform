# ---------------------------------------------------------------------------
# Confidential / local data.
# Nothing under local-data/ is ever committed except its README.
# See docs/data-policy.md — anything that reaches the production bundle is public.
# ---------------------------------------------------------------------------
local-data/*
!local-data/README.md

.env
.env.*

*.xlsx
*.xlsm
*.xls
*.csv.local

# ---------------------------------------------------------------------------
# ETL run artefacts.
# Drift reports and proposal bodies are per-run outputs, published as CI
# artefacts and job summaries rather than committed. The DATA the ETL writes
# (public/data/) is committed on purpose — that history is the audit trail.
# ---------------------------------------------------------------------------
etl/out/

# ---------------------------------------------------------------------------
# Build + tooling
# ---------------------------------------------------------------------------
node_modules/
dist/
.vite/
*.local
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
